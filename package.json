{
  "name": "oathconnect-workspace",
  "version": "0.2.0-alpha.3",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc -p relay/tsconfig.json",
    "test": "npm run build && node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261030.1",
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "miniflare": "5.20261023.3-beta",
    "typescript": "7.0.2",
    "wrangler": "4.156.0"
  }
}
