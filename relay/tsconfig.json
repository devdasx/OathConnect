{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023", "DOM"],
    "types": [], "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "skipLibCheck": true, "noEmit": true,
    "resolveJsonModule": true, "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*.ts"]
}
